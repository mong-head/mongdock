<Application x:Class="Mongdock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mongdock"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Menus.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 메뉴 행 최소 높이. 터치 장치가 있으면 Views/TouchSupport.ApplyResources 가 30 으로 바꿈 -->
            <sys:Double x:Key="MenuRowMinHeight">26</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
