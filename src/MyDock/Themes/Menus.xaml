<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 맥 스타일 메뉴 (전역). 색은 UiTheme.Apply 가 라이트/다크에 맞게 갈아 끼우는 동적 리소스.
         카드: 반경 10, 옅은 테두리, 부드러운 그림자, 안쪽 패딩 5 / 항목: 높이 26, 글자 14, 호버 = 강조색 둥근 사각형 + 흰 글자 -->

    <SolidColorBrush x:Key="Menu.Background" Color="#FAF9F9FA" />
    <SolidColorBrush x:Key="Menu.Border" Color="#1F000000" />
    <SolidColorBrush x:Key="Menu.Text" Color="#FF1D1D1F" />
    <SolidColorBrush x:Key="Menu.Disabled" Color="#4D000000" />
    <SolidColorBrush x:Key="Menu.Divider" Color="#14000000" />
    <SolidColorBrush x:Key="Menu.Accent" Color="#FF0A64D6" />
    <SolidColorBrush x:Key="Menu.AccentText" Color="#FFFFFFFF" />
    <sys:Double x:Key="Menu.ShadowOpacity">0.22</sys:Double>

    <!-- 카드 (그림자는 별도 Border 에만 걸어 글자가 흐려지지 않게) -->
    <ControlTemplate x:Key="MenuCardTemplate" TargetType="{x:Type ContentControl}">
        <Grid Margin="10,4,10,14">
            <Border CornerRadius="10" Background="{DynamicResource Menu.Background}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                      Opacity="{DynamicResource Menu.ShadowOpacity}" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="10" Background="{DynamicResource Menu.Background}"
                    BorderBrush="{DynamicResource Menu.Border}" BorderThickness="0.75" Padding="5">
                <ContentPresenter />
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Menu.Text}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <ContentControl Template="{StaticResource MenuCardTemplate}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" MinWidth="168" />
                    </ContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 구분선: 좌우 여백 있는 1px -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1" Margin="9,5" Background="{DynamicResource Menu.Divider}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Menu.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="Hl" CornerRadius="5" Background="{DynamicResource Menu.Accent}" Opacity="0" />
                        <Grid MinHeight="26" Margin="0,0,6,0">
                            <Grid.ColumnDefinitions>
                                <!-- 체크 표시 자리만 (아이콘 거터 없음) -->
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <!-- 단축키 (맥처럼 회색 작은 글씨, 오른쪽 정렬) -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcut" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuArrow" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Grid.Column="0" Text="✓" FontSize="12.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                            <ContentPresenter x:Name="Header" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False"
                                              VerticalAlignment="Center" Margin="0,0,14,1" />
                            <TextBlock x:Name="Shortcut" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       FontSize="13" Opacity="0.5" Margin="18,0,2,1" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="Arrow" Grid.Column="3" Text="›" FontSize="17" Margin="0,0,0,2"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-6" VerticalOffset="-13"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentControl Template="{StaticResource MenuCardTemplate}"
                                            FontFamily="{DynamicResource UiFont}" FontSize="14"
                                            TextOptions.TextFormattingMode="Ideal" Grid.IsSharedSizeScope="True">
                                <StackPanel IsItemsHost="True" MinWidth="150" />
                            </ContentControl>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Hl" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Menu.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Menu.Disabled}" />
                            <Setter TargetName="Hl" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
