<Window x:Class="MyDock.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        Width="90" Height="600">
    <!-- 루트는 배경 없음 → 투명 영역은 클릭이 아래 창으로 통과 -->
    <Grid x:Name="Root">
        <Border x:Name="PanelBorder" BorderThickness="1">
            <StackPanel x:Name="ItemsHost" />
        </Border>
    </Grid>
</Window>
