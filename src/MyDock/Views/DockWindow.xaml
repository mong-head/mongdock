<Window x:Class="MyDock.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mongdock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        Width="90" Height="600">
    <!-- 아이콘·점·테두리만 그리는 투명 창. 블러 배경은 DockBackdropWindow(바로 아래 창).
         루트는 평소 배경 없음 → 투명 영역은 클릭 통과. 확대 중에만 거의 투명한 배경으로 확대 영역을 붙잡는다. -->
    <Grid x:Name="Root">
        <Border x:Name="PanelBorder" BorderThickness="1">
            <StackPanel x:Name="ItemsHost" />
        </Border>
    </Grid>
</Window>
