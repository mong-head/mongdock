<Window x:Class="MyDock.Views.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MyDock.Views"
        Title="MyDock TopBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource BarFont}"
        Width="800" Height="32">
    <!-- 기본은 흰 바 + 아주 옅은 하단 구분선(코드에서 색 결정). 투명 모드에서도 Bar 배경은 알파 1 → 빈 곳 클릭/오른쪽 클릭을 바가 받음 -->
    <Border x:Name="Bar" BorderThickness="0,0,0,1">
        <!-- 두 구역을 한 칸에 겹쳐 왼쪽/오른쪽 정렬: 각 구역이 항상 바 전체 폭으로 측정됨
             (열/도킹 레이아웃에서 오른쪽 구역이 처음 측정된 좁은 폭에 갇혀 시계가 잘리던 문제 회피) -->
        <Grid>

            <!-- 오른쪽 (MyDockFinder 순서): 네트워크 속도 · 블루투스 · 와이파이 · 볼륨 · 검색 · 제어센터 · 알림 · 한/영 · 시계 -->
            <StackPanel x:Name="RightSection" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,12,0">
                <StackPanel x:Name="NetSpeed" VerticalAlignment="Center" Margin="0,0,8,0" Width="70">
                    <TextBlock x:Name="UpSpeed" FontSize="11" FontWeight="Bold" LineHeight="12.5" LineStackingStrategy="BlockLineHeight"
                               TextAlignment="Right" Text="↑ 0KB/s" />
                    <TextBlock x:Name="DownSpeed" FontSize="11" FontWeight="Bold" LineHeight="12.5" LineStackingStrategy="BlockLineHeight"
                               TextAlignment="Right" Text="↓ 0KB/s" />
                </StackPanel>

                <StackPanel x:Name="StatusIcons" Orientation="Horizontal">
                    <!-- 상태 아이콘: 맥 SF Symbols 같은 굵은 채움 도형 (BarIcons) -->
                    <Button x:Name="BluetoothButton" Style="{StaticResource BarIconButton}" Click="OnBluetoothClick">
                        <Path Width="12" Height="18" Data="{x:Static v:BarIcons.Bluetooth}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="WifiButton" Style="{StaticResource BarIconButton}" Click="OnWifiClick">
                        <Grid Width="21" Height="16">
                            <!-- 꺼진 칸은 같은 모양을 30% 로, 켜진 칸만 진하게 -->
                            <Path x:Name="WifiBack" Data="{x:Static v:BarIcons.WifiFull}" Opacity="0.3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Path x:Name="WifiFront" Data="{x:Static v:BarIcons.WifiFull}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="VolumeButton" Style="{StaticResource BarIconButton}"
                            Click="OnVolumeClick" MouseWheel="OnVolumeWheel">
                        <Path x:Name="VolumeIcon" Width="23" Height="18" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>

                <StackPanel x:Name="QuickButtons" Orientation="Horizontal">
                    <Button Style="{StaticResource BarIconButton}" Click="OnSearch">
                        <Path Width="18" Height="18" Data="{x:Static v:BarIcons.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <!-- 제어 센터 (빠른 설정) : 토글 두 개 -->
                    <Button x:Name="QuickSettingsButton" Style="{StaticResource BarButton}" Click="OnQuickSettings">
                        <Path Width="18" Height="16" Data="{x:Static v:BarIcons.ControlCenter}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource BarIconButton}" Click="OnNotifications">
                        <Path Width="17" Height="17" Data="{x:Static v:BarIcons.Bell}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>

                <!-- 한/영 배지: "한" = 글자색으로 채운 배경 + 반전 글자, "A" = 테두리만 -->
                <Button x:Name="ImeButton" Style="{StaticResource BarButton}" Padding="6,0" Margin="3,4,2,4" Click="OnImeToggle">
                    <Border x:Name="ImeBadge" CornerRadius="4" BorderThickness="1.3" MinWidth="22" Height="20" Padding="3,0">
                        <TextBlock x:Name="ImeText" Text="–" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Button>

                <TextBlock x:Name="Clock" VerticalAlignment="Center" Margin="10,0,2,0" FontSize="17" />
            </StackPanel>

            <!-- 왼쪽: 로고 메뉴 · 가상 데스크톱 버튼 · 현재 앱 이름 (버튼은 앱 이름 길이와 무관하게 고정 위치) -->
            <StackPanel x:Name="LeftSection" HorizontalAlignment="Left" Orientation="Horizontal" Margin="10,0,0,0">
                <Button x:Name="LogoButton" Style="{StaticResource BarButton}" Padding="9,0" Click="OnLogoClick">
                    <!-- 윈도우 11 로고: 정사각형 4개 + 작은 틈, 단색 -->
                    <Path Width="19" Height="19" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M0,0 H7.4 V7.4 H0 Z M8.6,0 H16 V7.4 H8.6 Z M0,8.6 H7.4 V16 H0 Z M8.6,8.6 H16 V16 H8.6 Z" />
                </Button>
                <StackPanel x:Name="DesktopButtons" Orientation="Horizontal">
                    <Button Style="{StaticResource BarIconButton}" FontSize="15" Content="&#xE76B;" Click="OnPreviousDesktop" />
                    <Button Style="{StaticResource BarIconButton}" FontSize="15" Content="&#xE76C;" Click="OnNextDesktop" />
                    <Button Style="{StaticResource BarIconButton}" FontSize="15" Content="&#xE710;" Click="OnNewDesktop" />
                </StackPanel>
                <TextBlock x:Name="AppName" FontWeight="Bold" FontFamily="Segoe UI, Malgun Gothic" FontSize="16.5" VerticalAlignment="Center"
                           Margin="12,0,10,1" TextTrimming="CharacterEllipsis" MaxWidth="420" />
            </StackPanel>


        </Grid>
    </Border>
</Window>
