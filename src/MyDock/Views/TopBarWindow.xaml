<Window x:Class="MyDock.Views.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MyDock.Views"
        Title="mongdock TopBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontWeight="Medium"
        FontFamily="{DynamicResource UiFont}"
        Width="800" Height="26">
    <!-- 기본은 흰 바 + 아주 옅은 하단 구분선(코드에서 색 결정). 투명 모드에서도 Bar 배경은 알파 1 → 빈 곳 클릭/오른쪽 클릭을 바가 받음 -->
    <Border x:Name="Bar" BorderThickness="0,0,0,1">
        <!-- 두 구역을 한 칸에 겹쳐 왼쪽/오른쪽 정렬: 각 구역이 항상 바 전체 폭으로 측정됨
             (열/도킹 레이아웃에서 오른쪽 구역이 처음 측정된 좁은 폭에 갇혀 시계가 잘리던 문제 회피) -->
        <Grid>

            <!-- 오른쪽 (MyDockFinder 순서): 네트워크 속도 · 블루투스 · 와이파이 · 볼륨 · 검색 · 제어센터 · 알림 · 한/영 · 시계 -->
            <StackPanel x:Name="RightSection" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,10,0">
                <!-- 가상 데스크톱 그룹 [‹] [1 / 4] [›] — 숫자 클릭 = 작업 보기. 시계 폭이 고정이라 위치가 항상 같음 -->
                <Border x:Name="DesktopButtons" VerticalAlignment="Center" CornerRadius="7" Height="22" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Margin="2,0">
                        <Button x:Name="PrevDesktopButton" Style="{StaticResource BarButton}" Padding="6,0" Margin="0,1" MinWidth="0" Click="OnPreviousDesktop">
                            <Path Width="10" Height="16" LayoutTransform="{StaticResource BarIconScale}" Data="{x:Static v:BarIcons.ChevronLeft}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="DesktopIndexButton" Style="{StaticResource BarButton}" Padding="5,0" Margin="0,1" MinWidth="0" Click="OnTaskView">
                            <TextBlock x:Name="DesktopIndex" FontSize="12.5" Margin="0,0,0,1" MinWidth="28" TextAlignment="Center" />
                        </Button>
                        <Button x:Name="NextDesktopButton" Style="{StaticResource BarButton}" Padding="6,0" Margin="0,1" MinWidth="0" Click="OnNextDesktop">
                            <Path Width="10" Height="16" LayoutTransform="{StaticResource BarIconScale}" Data="{x:Static v:BarIcons.ChevronRight}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="NetSpeed" VerticalAlignment="Center" Margin="0,0,6,0" Width="60">
                    <TextBlock x:Name="UpSpeed" FontSize="9.5" FontWeight="Bold" LineHeight="11" LineStackingStrategy="BlockLineHeight"
                               TextAlignment="Right" Text="↑ 0KB/s" />
                    <TextBlock x:Name="DownSpeed" FontSize="9.5" FontWeight="Bold" LineHeight="11" LineStackingStrategy="BlockLineHeight"
                               TextAlignment="Right" Text="↓ 0KB/s" />
                </StackPanel>

                <StackPanel x:Name="StatusIcons" Orientation="Horizontal">
                    <!-- 상태 아이콘: 맥 SF Symbols 같은 굵은 채움 도형 (BarIcons) -->
                    <Button x:Name="BluetoothButton" Style="{StaticResource BarIconButton}" Click="OnBluetoothClick">
                        <Path Width="12" Height="18" LayoutTransform="{StaticResource BarIconScale}" Data="{x:Static v:BarIcons.Bluetooth}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="WifiButton" Style="{StaticResource BarIconButton}" Click="OnWifiClick">
                        <Grid Width="21" Height="16" LayoutTransform="{StaticResource BarIconScale}">
                            <!-- 꺼진 칸은 같은 모양을 30% 로, 켜진 칸만 진하게 -->
                            <Path x:Name="WifiBack" Data="{x:Static v:BarIcons.WifiFull}" Opacity="0.3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Path x:Name="WifiFront" Data="{x:Static v:BarIcons.WifiFull}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="VolumeButton" Style="{StaticResource BarIconButton}"
                            Click="OnVolumeClick" MouseWheel="OnVolumeWheel">
                        <Path x:Name="VolumeIcon" Width="23" Height="18" LayoutTransform="{StaticResource BarIconScale}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>

                <StackPanel x:Name="QuickButtons" Orientation="Horizontal">
                    <Button Style="{StaticResource BarIconButton}" Click="OnSearch">
                        <Path Width="18" Height="18" LayoutTransform="{StaticResource BarIconScale}" Data="{x:Static v:BarIcons.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <!-- 제어 센터 (빠른 설정) : 토글 두 개 -->
                    <Button x:Name="QuickSettingsButton" Style="{StaticResource BarButton}" Click="OnQuickSettings">
                        <Path Width="18" Height="16" LayoutTransform="{StaticResource BarIconScale}" Data="{x:Static v:BarIcons.ControlCenter}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>

                <!-- 한/영 배지: "한" = 글자색으로 채운 배경 + 반전 글자, "A" = 테두리만 -->
                <Button x:Name="ImeButton" Style="{StaticResource BarButton}" Padding="5,0" Margin="2,3,2,3" Click="OnImeToggle">
                    <Border x:Name="ImeBadge" CornerRadius="3.5" BorderThickness="1.2" MinWidth="18" Height="17" Padding="2,0">
                        <TextBlock x:Name="ImeText" Text="–" FontWeight="Bold" FontSize="11.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Button>

                <!-- 시계: 클릭 = 알림 센터 + 달력 (MyDockFinder 와 동일) -->
                <Button x:Name="ClockButton" Style="{StaticResource BarButton}" Padding="7,0" Margin="3,3,0,3" Click="OnClockClick">
                    <TextBlock x:Name="Clock" FontSize="13.5" TextAlignment="Right" />
                </Button>
            </StackPanel>

            <!-- 왼쪽: 로고 메뉴 · 가상 데스크톱 버튼 · 현재 앱 이름 (버튼은 앱 이름 길이와 무관하게 고정 위치) -->
            <StackPanel x:Name="LeftSection" HorizontalAlignment="Left" Orientation="Horizontal" Margin="10,0,0,0">
                <Button x:Name="LogoButton" Style="{StaticResource BarButton}" Padding="8,0" Click="OnLogoClick">
                    <!-- 윈도우 로고: 둥근 모서리 타일 4개, 단색 -->
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Path.Data>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,7.2,7.2" RadiusX="2.2" RadiusY="2.2" />
                                <RectangleGeometry Rect="8.8,0,7.2,7.2" RadiusX="2.2" RadiusY="2.2" />
                                <RectangleGeometry Rect="0,8.8,7.2,7.2" RadiusX="2.2" RadiusY="2.2" />
                                <RectangleGeometry Rect="8.8,8.8,7.2,7.2" RadiusX="2.2" RadiusY="2.2" />
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                </Button>
                <!-- 앱 이름: 클릭 = 앱 메뉴 (맥 앱 메뉴) -->
                <Button x:Name="AppNameButton" Style="{StaticResource BarButton}" Padding="7,0" Margin="3,3,0,3" Click="OnAppNameClick">
                    <TextBlock x:Name="AppName" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,1"
                               TextTrimming="CharacterEllipsis" MaxWidth="420" />
                </Button>
                <!-- 앱 메뉴 제목들 (파일 편집 보기 …) — 넘치면 » 하나로 묶음 -->
                <StackPanel x:Name="AppMenuBar" Orientation="Horizontal" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
